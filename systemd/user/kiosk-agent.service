# kiosk-client agent user service
#
# This service starts the local kiosk-agent in the user manager.
# The agent listens on loopback only, exposes local HTTP status endpoints, and
# starts the outbound central-management heartbeat when configured.

[Unit]
Description=kiosk-client agent
After=default.target

[Service]
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/kiosk-agent
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
