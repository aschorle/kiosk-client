# Beispiel-Konfigurationsdatei für kiosk-client

# Die URL, die im Kiosk angezeigt wird
URL=https://display.example.local

# Eindeutige Gerätekennung
DEVICE_ID=display01

# Optional: URL des zentralen Kiosk-Servers. Leer deaktiviert Management.
SERVER_URL=https://kiosk-server.example.local

# Optionaler Anzeigename im zentralen Admin.
DEVICE_NAME=Display 01

# Token für lokale Schreib-API und zentralen Heartbeat. Nicht committen.
AUTH_TOKEN=replace-with-a-secret-token
